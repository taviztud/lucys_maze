{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "vite.config.ts",
        "playwright.config.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "tests/node/**/*.ts"
    ]
}
